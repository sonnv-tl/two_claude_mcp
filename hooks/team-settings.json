{
  "permissions": {
    "allow": [
      "mcp__team-hub",
      "mcp__browser",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Skill(backend-review)",
      "mcp__playwright",
      "mcp__figma-unlimited__figma_status",
      "mcp__figma-unlimited__figma_get_file",
      "mcp__figma-unlimited__figma_search",
      "mcp__figma-unlimited__figma_get_node",
      "mcp__figma-unlimited__figma_get_css",
      "mcp__figma-unlimited__figma_get_component_states",
      "mcp__figma-unlimited__figma_get_variables",
      "mcp__figma-unlimited__figma_get_styles",
      "mcp__figma-unlimited__figma_screenshot",
      "mcp__figma-unlimited__figma_export",
      "mcp__figma-unlimited__figma_export_images",
      "mcp__figma-unlimited__figma_compare",
      "mcp__figma-unlimited__figma_delete_copy",
      "mcp__figma-unlimited__figma_execute",
      "mcp__figma-unlimited__figma_close"
    ],
    "deny": [
      "mcp__claude_ai_Figma"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/two_claude_mcp/scripts/hook.mjs stop",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/two_claude_mcp/scripts/hook.mjs notify",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/two_claude_mcp/scripts/hook.mjs post",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/two_claude_mcp/scripts/hook.mjs prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/laragon/www/two_claude_mcp/scripts/hook.mjs session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
